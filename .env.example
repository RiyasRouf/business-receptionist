# Non-secret config baseline — copy to .env; inject secrets via vault at runtime

APP_NAME="AI Business Receptionist"
APP_ENV=staging
APP_DEBUG=false
APP_URL=http://34.18.220.92
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=aiwa_staging_db
DB_USERNAME=aiwa_staging
DB_PASSWORD=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# JWT — inject via vault. TTLs per ADR-058: access 15min, refresh 7 days
JWT_SECRET=
JWT_TTL=15
JWT_REFRESH_TTL=10080

# AI Provider — inject via vault. Platform-level default only; actual
# per-tenant provider/model selection lives in tenant_config (ADR-053),
# set via Platform Admin console (Module 5, Sprint 2) — not this env var.
# NOTE: stays 'mock' — gemini-2.5-flash generateContent is currently
# gated on the provided key's project (404 new-user / 429 quota=0);
# embeddings work fine through the same key. Flip once billing/quota
# is sorted, no code change needed.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Voice — inject via vault
VOICE_PROVIDER=vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_APPLICATION_ID=
VONAGE_PRIVATE_KEY_PATH=
VONAGE_FROM_NUMBER=

# WhatsApp Business API sandbox (D-013-01) — inject via vault. Sandbox
# registration blocked pending Meta Developer account (phone OTP access).
MESSAGING_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# 360dialog — alternative WhatsApp BSP (MESSAGING_PROVIDER=360dialog).
# Sandbox onboarding doesn't need Meta's own business verification.
DIALOG360_API_KEY=
DIALOG360_BASE_URL=https://waba-v2.360dialog.io
DIALOG360_WEBHOOK_USER=
DIALOG360_WEBHOOK_PASS=

# STT/TTS — inject via vault
STT_PROVIDER=
TTS_PROVIDER=

# Secrets vault — GCP Secret Manager (D-014-02, supersedes HashiCorp Vault)
GOOGLE_CLOUD_PROJECT=business-receptionist
GOOGLE_APPLICATION_CREDENTIALS=

# Cloudflare (future)
CLOUDFLARE_ZONE_ID=
